{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HabitatDatabase": "Server=localhost;Port=3306;Database=habitat_progress;User=habitat_user;Password=habitat_password;SslMode=Preferred;AllowPublicKeyRetrieval=True;"
  },
  "Jwt": {
    "Issuer": "Habitat.BackEnd.Progress",
    "Audience": "Habitat.Progress.Mobile",
    "ExpiresInMinutes": 60
  },
  "DatabaseRetry": {
    "MaxAttempts": 3,
    "BaseDelayMilliseconds": 150
  },
  "Security": {
    "UseHttpsRedirection": false
  }
}
